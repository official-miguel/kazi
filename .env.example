# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API.

# Safe in the browser. Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SECRET. Server only. Used to create accounts and for the admin portal.
# Never commit it, never share it, and never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
